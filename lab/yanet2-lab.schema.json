{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanet-platform/yanet2/lab/yanet2-lab.schema.json",
  "title": "YANET2 lab manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "$ref": "#/$defs/name" },
    "description": { "type": "string" },
    "boot": {
      "type": "object",
      "description": "Boot YANET with custom dataplane/controlplane configuration. Restores the pre-YANET snapshot, so the operator baseline (route/forward/decap/pipeline, BIRD, fn:lab) is NOT available in boot manifests. Common baseline configuration (kni0 interface, forwarding rules, route FIB) is still applied after the custom boot.",
      "additionalProperties": false,
      "properties": {
        "dataplane": { "$ref": "#/$defs/path" },
        "controlplane": { "$ref": "#/$defs/path" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "destination"],
        "properties": {
          "source": { "$ref": "#/$defs/path" },
          "destination": { "type": "string", "minLength": 1 }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argv"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "timeout": { "$ref": "#/$defs/duration" }
        }
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ingress", "egress", "send", "expect"],
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "ingress": { "type": "integer", "minimum": 0, "maximum": 1 },
          "egress": { "type": "integer", "minimum": 0, "maximum": 1 },
          "timeout": { "$ref": "#/$defs/duration" },
          "send": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pcap"],
            "properties": { "pcap": { "$ref": "#/$defs/path" } }
          },
          "expect": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["pcap"],
                "properties": { "pcap": { "$ref": "#/$defs/path" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["drop"],
                "properties": { "drop": { "const": true } }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "path": { "type": "string", "minLength": 1 },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    }
  }
}
