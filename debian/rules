#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# Enable verbose output for debugging
export DH_VERBOSE = 1
export DH_OPTIONS=-v
export DEB_CFLAGS_MAINT_APPEND = -fno-lto
export DEB_LDFLAGS_MAINT_APPEND = -fno-lto

# Enable all hardening options
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Set parallel build options
export DEB_BUILD_OPTIONS = parallel=$(shell nproc)

# Meson build directory
BUILDDIR = build

%:
	dh $@ --parallel

override_dh_auto_configure:
	meson setup $(BUILDDIR) \
			--default-library=static \
			-Dfuzzing=disabled \
			-Dtrace=disabled \
			-Dversion=$(DEB_VERSION); \

execute_after_dh_auto_install:
	./scripts/gen-shell-completions.sh debian/yanet2-cli.install \
		debian/tmp/usr/share/bash-completion/completions \
		debian/tmp/usr/share/zsh/vendor-completions

# Handle missing files more gracefully
override_dh_missing:
	dh_missing --fail-missing

override_dh_dwz:
	: # Skip dwz compression to avoid errors with compressed debug sections

override_dh_strip:
	dh_strip --dbgsym-migration='yanet2-dbgsym (<< 0.0.1-1~)'

