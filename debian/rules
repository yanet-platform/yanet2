#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# Enable verbose output for debugging
export DH_VERBOSE = 1
export DH_OPTIONS=-v
export DEB_CFLAGS_MAINT_APPEND = -fno-lto
export DEB_LDFLAGS_MAINT_APPEND = -fno-lto

# Enable all hardening options
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
YANET_VERSION ?= $(DEB_VERSION)
export YANET_VERSION

# Fall back to nproc for parallel jobs when the caller supplies none.
#
# The dpkg-buildpackage tool exports DEB_BUILD_OPTIONS with a parallel
# value defaulting to the processor count (absent -j, -J, or parallel=)
# before debian/rules runs, so this fallback only takes effect when
# debian/rules is invoked directly.
ifeq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
export DEB_BUILD_OPTIONS += parallel=$(shell nproc)
endif

# Meson build directory
BUILDDIR = build

%:
	dh $@ --parallel

override_dh_auto_configure:
	meson setup $(BUILDDIR) \
			--default-library=static \
			-Dfuzzing=disabled \
			-Dtrace=disabled \
			-Dversion=$(DEB_VERSION); \

# The packaging build already compiles the whole tree, so running the suite here
# validates the source rather than the packages.
override_dh_auto_test:
	:

execute_after_dh_auto_clean:
	$(MAKE) -C scripts/uprobe clean

execute_after_dh_auto_build:
ifneq (,$(filter yanet2-uprobe,$(shell dh_listpackages)))
	$(MAKE) -C scripts/uprobe prepare
	$(MAKE) -C scripts/uprobe all
endif

execute_after_dh_auto_install:
ifneq (,$(filter yanet2-uprobe,$(shell dh_listpackages)))
	$(MAKE) -C scripts/uprobe install DESTDIR=$(CURDIR)/debian/tmp
endif
	./scripts/gen-shell-completions.sh debian/yanet2-cli.install \
		debian/tmp/usr/share/bash-completion/completions \
		debian/tmp/usr/share/zsh/vendor-completions

# Handle missing files more gracefully
override_dh_missing:
	dh_missing --fail-missing

override_dh_dwz:
	: # Skip dwz compression to avoid errors with compressed debug sections

override_dh_strip:
	dh_strip --dbgsym-migration='yanet2-dbgsym (<< 0.0.1-1~)'
