[Unit]
Description=yanet2 controlplane (%i)
After=yanet2-dataplane.service
Requires=yanet2-dataplane.service
BindsTo=yanet2-dataplane.service
PartOf=yanet2-controlplane.target
# Without this a typo'd instance name respawns once a second forever, since
# Restart=always is paired with rate limiting disabled below.
ConditionPathExists=/etc/yanet2/controlplane.d/%i.yaml
StartLimitBurst=3600000
StartLimitIntervalSec=0

[Service]
User=root
Group=yanet

ExecStart=/usr/bin/yanet-controlplane -c /etc/yanet2/controlplane.d/%i.yaml
TimeoutSec=1200
TimeoutStopSec=30
Restart=always
RestartSec=1
LimitCORE=infinity

[Install]
WantedBy=yanet2-controlplane.target
